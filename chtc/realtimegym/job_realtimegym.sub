# RealtimeGym vanilla baseline: 1 GPU, vLLM + concurrent eval processes.
# NOTE: deliberately no initial_dir. In the verl template, initial_dir=results/<tag>
# makes transfer_input_files resolve relative to that dir, not to chtc/.
# Submitting from chtc/ with plain paths removes the ambiguity. Results are
# copied to /staging by the job itself, so no transfer_output_files needed.
universe = container
container_image = docker://verlai/verl:vllm012.latest

executable  = job_realtimegym.sh
arguments   = $(Process)

log         = logs/$(runtag)/$(Process).log
output      = logs/$(runtag)/$(Process).out
error       = logs/$(runtag)/$(Process).err

stream_output           = true
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_input_files    = .env, job_realtimegym.sh

environment = "MODEL=$(model) GAME=$(game) LOAD=$(load) PRESSURE=$(pressure) IBUDGET=$(ibudget) SEEDS=$(seeds) REPEATS=$(repeats) MAXSTEPS=$(maxsteps) RUNTAG=$(runtag)"

# 8 eval processes + one 8B model. The verl template's 200GB/200GB is a
# training-sized ask that slows matching; this matches faster.
request_cpus            = 8
request_memory          = 64GB
request_disk            = 80GB

request_gpus            = 1
requirements            = (Target.HasCHTCStaging == true) && (Target.CUDADriverVersion >= 12.1) && (Target.GPUs_GlobalMemoryMb > 40000)

+WantGPULab             = true
+WantFlocking           = false
+WantGlidein            = false
+GPUJobLength           = "short"

queue 1
